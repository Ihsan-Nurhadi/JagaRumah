# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Akar CA Supabase wajib ikut repo, bukan rahasia, dan tanpa berkas ini seluruh koneksi
# database ditolak. Dikecualikan dari aturan *.pem di atas.
!db/certs/*.pem

# cache lokal yang dialihkan ke dalam repo supaya sandbox tidak menulis ke home
/.cache/
/.config/
/.pnpm-store/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
logs/
