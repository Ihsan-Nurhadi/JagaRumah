# Supabase: pakai host pooler, bukan host db.<ref>.supabase.co.
# Host db.<ref>.supabase.co hanya punya alamat IPv6, sehingga gagal tersambung dari jaringan
# yang tidak punya rute IPv6. Host pooler punya alamat IPv4 dan bekerja di keduanya.
# Bentuk: postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Enkripsi diatur oleh src/lib/server/tls.ts, bukan oleh parameter di URL ini. Akar CA
# Supabase ada di db/certs dan dipakai sebagai jangkar verifikasi. Jangan menambahkan
# sslmode di sini: parameter URL menimpa pengaturan di kode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# development atau production. Dipakai memutuskan atribut Secure pada cookie sesi.
APP_ENV=development

# JWT
JWT_CUSTOMER_ACCESS_SECRET=
# Mailtrap SMTP untuk kirim OTP reset password customer.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=
MAILTRAP_FROM_EMAIL=no-reply@nayaka.test
MAILTRAP_FROM_NAME=Nayaka
JWT_CUSTOMER_REFRESH_SECRET=
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# Enkripsi secret perangkat dan pepper hash OTP/claim
ENCRYPTION_KEY=

# CSRF
CSRF_SECRET=

# Pakasir
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
PAKASIR_MODE=sandbox
PAKASIR_WEBHOOK_PATH_SECRET=
PAKASIR_MIN_AMOUNT=1000

# WhatsApp OTP
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER=
